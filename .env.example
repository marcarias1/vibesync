# ---- MongoDB (Atlas local vía Docker: single-node RS + vector search) ----
MONGO_URI=mongodb://localhost:27017/?directConnection=true
MONGO_DB=vibesync

# ---- LLM (DeepSeek V4 Flash, OpenAI-compatible) ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- Enriquecimiento (gratis) ----
LASTFM_API_KEY=
MUSICBRAINZ_USER_AGENT=vibesync/0.1 (marcariasdonnay@gmail.com)

# ---- Spotify OAuth (PKCE) ----
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# ---- Seguridad ----
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ---- Embeddings ----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
HF_TOKEN=